# Copy to .env before running docker compose up -d.
# For reproducible deployments, replace stable with a tested n8n version.
N8N_VERSION=stable

# Local k3d Ingress: published port 8081, routing by Host prometheus.local.
# The prometheus-mcp service maps this hostname to host-gateway.
PROMETHEUS_URL=http://prometheus.local:8081

# Store API tokens in n8n Credentials, not in this example or workflow JSON.
# n8n generates its encryption key and persists it in the n8n_storage volume.
