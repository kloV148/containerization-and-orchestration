apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: ${VS_NAME}
  namespace: ${NAMESPACE}
spec:
  hosts:
    - ${API_HOST}
  http:
    - route:
        - destination:
            host: ${API_HOST}
            subset: v1
          weight: ${V1_WEIGHT}
        - destination:
            host: ${API_HOST}
            subset: v2
          weight: ${V2_WEIGHT}
