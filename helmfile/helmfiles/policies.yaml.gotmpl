bases:
  - ../bases/repositories.yaml.gotmpl
  - ../bases/common.yaml.gotmpl

defaultInherit:
  - common

releases:
  - name: kyverno
    namespace: kyverno
    chart: kyverno/kyverno
    version: 3.9.1

  - name: kyverno-policies
    namespace: api
    chart: ../charts/kyverno-policies
    needs:
      - kyverno/kyverno
