server:
  image:
    repository: quay.io/prometheus/prometheus
    tag: "v3.13.2"

scrapeConfigs:
  kubernetes-pods:
    post_relabel_configs: |
      - source_labels:
          - __meta_kubernetes_pod_label_app_kubernetes_io_component
        target_label: component
      - source_labels:
          - __meta_kubernetes_pod_label_app_kubernetes_io_part_of
        target_label: part_of

serverFiles:
  alerting_rules.yml:
    groups:
      - name: api
        rules:
          - alert: HighErrorRate
            expr: >-
              (
                sum by (component, part_of) (
                  rate(http_errors_total{component="api"}[5m])
                )
                /
                sum by (component, part_of) (
                  rate(http_requests_total{component="api"}[5m])
                )
              ) > 0.5
              and
              sum by (component, part_of) (
                increase(http_requests_total{component="api"}[5m])
              ) >= 10
            for: 5m
            labels:
              severity: "Critical"
            annotations:
              summary: "API error rate is above 50%"
          - alert: HighLatency
            expr: >-
              histogram_quantile(
                0.95,
                sum by (le, component, part_of) (
                  rate(http_request_duration_seconds_bucket{
                    component="api"
                  }[5m])
                )
              ) > 5
            for: 5m
            labels:
              severity: "Critical"
            annotations:
              summary: "High responce latency"
          - alert: ApiDown
            expr: >-
              up{component="api"} == 0
              or
              absent(up{component="api"})
            for: 5m
            labels:
              severity: "Critical"
            annotations:
              summary: "Api is DOWN"      

extraManifests:
  - |
    apiVersion: v1
    kind: Secret
    metadata:
      name: prometheus-secrets
      namespace: {{ .Release.Namespace }}
    type: Opaque
    stringData:
      bot-token: {{`{{ .Values.prometheusSecret.bot_token | quote }}`}}
      chat-id: {{`{{ .Values.prometheusSecret.chat_id | quote }}`}}

alertmanager:
  enabled: true
  image:
    tag: "v0.33.1"
  templates:
    alertmanager.tmpl: |-
{{ readFile "template.tmpl" | indent 6 }}
  config:
    route:
      group_wait: 10s
      group_interval: 5m
      receiver: telegram
      repeat_interval: 1h
    receivers:
      - name: telegram
        telegram_configs:
          - bot_token_file: /etc/am-secrets/bot-token
            chat_id_file: /etc/am-secrets/chat-id
            send_resolved: true
            message: '{{`{{ template "telegram.lab2.text" . }}`}}'
  extraSecretMounts:
    - name: chat-bot-token
      mountPath: /etc/am-secrets/
      secretName: prometheus-secrets
      readOnly: true
